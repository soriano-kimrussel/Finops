# Copy to .env (scripts/setup-db.ps1 does this and fills in generated secrets).

APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Runtime connection: least-privilege role, subject to row-level security.
DATABASE_URL=postgres://finops_app:CHANGE_ME@127.0.0.1:5432/finops_dev?sslmode=disable
# Migrations, seeding and backfills: schema owner role.
MIGRATE_DATABASE_URL=postgres://finops_owner:CHANGE_ME@127.0.0.1:5432/finops_dev?sslmode=disable

# Go tests create throwaway databases from this server (owner role needs CREATEDB).
TEST_DATABASE_URL=postgres://finops_owner:CHANGE_ME@127.0.0.1:5432/finops_test?sslmode=disable
TEST_APP_PASSWORD=CHANGE_ME

# 32 random bytes, base64. Encrypts OAuth tokens at rest.
TOKEN_ENCRYPTION_KEY=

# QuickBooks: "simulated" uses bundled sample data and is labelled as such in the UI.
# "live" talks to Intuit and needs the credentials below.
QUICKBOOKS_MODE=simulated
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URL=http://localhost:5173/api/integrations/quickbooks/callback
QUICKBOOKS_WEBHOOK_VERIFIER_TOKEN=
